#: ckanext/validate/helpers.py:31 ckanext/validate/helpers.py:35
#: ckanext/validate/helpers.py:327
msgid "Structural validation error"
msgstr "Error de validación estructural"

#: ckanext/validate/helpers.py:32
msgid "The validator could not extract row-level errors from the report."
msgstr "El validador no pudo extraer errores a nivel de fila del reporte."

#: ckanext/validate/helpers.py:61 ckanext/validate/helpers.py:333
msgid "Validation error"
msgstr "Error de validación"

#: ckanext/validate/helpers.py:64
msgid "Unknown validation error"
msgstr "Error de validación desconocido"

#: ckanext/validate/helpers.py:319 ckanext/validate/helpers.py:325
msgid "Missing header"
msgstr "Encabezado faltante"

#: ckanext/validate/helpers.py:320
msgid "Duplicate header"
msgstr "Encabezado duplicado"

#: ckanext/validate/helpers.py:321
msgid "Empty row"
msgstr "Fila vacía"

#: ckanext/validate/helpers.py:322
msgid "Type mismatch"
msgstr "Tipo de dato incorrecto"

#: ckanext/validate/helpers.py:323
msgid "Missing value"
msgstr "Valor faltante"

#: ckanext/validate/helpers.py:324
msgid "Extra cell"
msgstr "Celda adicional"

#: ckanext/validate/helpers.py:326
msgid "Blank label"
msgstr "Etiqueta vacía"

#: ckanext/validate/helpers.py:340 ckanext/validate/helpers.py:362
msgid ""
"A column in the header row has no name. Every column should have a "
"unique, non-empty header."
msgstr ""
"Una columna de la fila de encabezado no tiene nombre. Cada columna debe "
"tener un encabezado único y no vacío."

#: ckanext/validate/helpers.py:344
msgid "Two or more columns share the same name. Column names must be unique."
msgstr ""
"Dos o más columnas tienen el mismo nombre. Los nombres de las columnas "
"deben ser únicos."

#: ckanext/validate/helpers.py:348
msgid "This row has no data. Rows should contain at least one cell with data."
msgstr ""
"Esta fila no contiene datos. Las filas deben contener al menos una celda "
"con datos."

#: ckanext/validate/helpers.py:352
msgid ""
"A cell value does not match the expected data type or format for the "
"column."
msgstr ""
"El valor de una celda no coincide con el tipo de dato o formato esperado "
"para la columna."

#: ckanext/validate/helpers.py:356
msgid "This cell is missing data."
msgstr "Esta celda no contiene un valor."

#: ckanext/validate/helpers.py:359
msgid "This row has more values than the header row."
msgstr "Esta fila tiene más valores que la fila de encabezado."

#: ckanext/validate/helpers.py:366
msgid "A label in the header row is missing a value. Labels must not be blank."
msgstr ""
"Falta un valor en una etiqueta del encabezado. Las etiquetas no pueden "
"estar vacías."

#: ckanext/validate/helpers.py:370
msgid ""
"The validator could not extract row-level errors from the validation "
"report."
msgstr ""
"El validador no pudo extraer errores a nivel de fila del informe de "
"validación."

#: ckanext/validate/actions/action.py:69
msgid "Only CSV resources can be validated."
msgstr "Solo se pueden validar recursos CSV."

#: ckanext/validate/actions/action.py:91
msgid "System error: {0}"
msgstr "Error del sistema: {0}"

#: ckanext/validate/actions/action.py:134
msgid "No validation found for resource {0}"
msgstr "No se encontró validación para el recurso {0}"

#: ckanext/validate/actions/action.py:163
msgid "Invalid job status. Valid values are: {0}"
msgstr "Estado de trabajo inválido. Los valores válidos son: {0}"

#: ckanext/validate/actions/action.py:171
msgid "Must be an integer."
msgstr "Debe ser un número entero."

#: ckanext/validate/actions/action.py:175
msgid "Must be a positive integer."
msgstr "Debe ser un número entero positivo."

#: ckanext/validate/auth/validation.py:9
#: ckanext/validate/blueprints/resource.py:70
msgid "Not authorized to validate this resource"
msgstr "No autorizado para validar este recurso"

#: ckanext/validate/auth/validation.py:18
msgid "Not authorized to view this resource"
msgstr "No autorizado para ver este recurso"

#: ckanext/validate/auth/validation.py:43
msgid "You must be logged in to validate a file."
msgstr "Debe iniciar sesión para validar un archivo."

#: ckanext/validate/auth/validation.py:67
#: ckanext/validate/blueprints/resource.py:131
msgid "You must be an editor or administrator to validate a file."
msgstr "Debe ser editor o administrador para validar un archivo."

#: ckanext/validate/blueprints/admin.py:25
msgid "Need to be system administrator to administer"
msgstr "Debe ser administrador del sistema para administrar"

#: ckanext/validate/blueprints/admin.py:32
msgid "Invalid job status: {0}"
msgstr "Estado de trabajo inválido: {0}"

#: ckanext/validate/blueprints/resource.py:35
msgid "Package not found"
msgstr "Paquete no encontrado"

#: ckanext/validate/blueprints/resource.py:42
#: ckanext/validate/blueprints/resource.py:206
msgid "Resource not found"
msgstr "Recurso no encontrado"

#: ckanext/validate/blueprints/resource.py:75
msgid "Validation completed. No errors found."
msgstr "Validación completada. No se encontraron errores."

#: ckanext/validate/blueprints/resource.py:78
msgid "Validation completed. {} errors found."
msgstr "Validación completada. Se encontraron {} errores."

#: ckanext/validate/blueprints/resource.py:83
msgid "Validation completed."
msgstr "Validación completada."

#: ckanext/validate/blueprints/resource.py:147
msgid "Please select a CSV file to validate."
msgstr "Por favor seleccione un archivo CSV para validar."

#: ckanext/validate/blueprints/resource.py:155
msgid "Only CSV files are supported."
msgstr "Solo se admiten archivos CSV."

#: ckanext/validate/blueprints/resource.py:175
msgid "System error during validation: {0}"
msgstr "Error del sistema durante la validación: {0}"

#: ckanext/validate/templates/admin/base.html:5
#: ckanext/validate/templates/admin/validation_jobs.html:3
#: ckanext/validate/templates/admin/validation_jobs.html:11
msgid "Validation Jobs"
msgstr "Trabajos de validación"

#: ckanext/validate/templates/admin/validation_jobs.html:14
msgid "Latest CSV validation background jobs."
msgstr "Últimos trabajos de validación CSV en segundo plano."

#: ckanext/validate/templates/admin/validation_jobs.html:18
msgid "Important:"
msgstr "Importante:"

#: ckanext/validate/templates/admin/validation_jobs.html:19
msgid ""
"manually triggered validations do not create a background job. Therefore,"
" that action will not be listed here."
msgstr ""
"las validaciones activadas manualmente no crean un trabajo en segundo "
"plano. Por lo tanto, esa acción no se mostrará aquí."

#: ckanext/validate/templates/admin/validation_jobs.html:24
#: ckanext/validate/templates/admin/validation_jobs.html:53
msgid "Status"
msgstr "Estado"

#: ckanext/validate/templates/admin/validation_jobs.html:26
msgid "All"
msgstr "Todos"

#: ckanext/validate/templates/admin/validation_jobs.html:37
msgid "Filter"
msgstr "Filtrar"

#: ckanext/validate/templates/admin/validation_jobs.html:42
msgid "Clear"
msgstr "Limpiar"

#: ckanext/validate/templates/admin/validation_jobs.html:51
msgid "ID"
msgstr "ID"

#: ckanext/validate/templates/admin/validation_jobs.html:52
msgid "Resource"
msgstr "Recurso"

#: ckanext/validate/templates/admin/validation_jobs.html:54
msgid "Created"
msgstr "Creado"

#: ckanext/validate/templates/admin/validation_jobs.html:55
msgid "Finished"
msgstr "Finalizado"

#: ckanext/validate/templates/admin/validation_jobs.html:93
msgid "No validation jobs found from the selected status."
msgstr "No se encontraron trabajos de validación para el estado seleccionado."

#: ckanext/validate/templates/package/resource_read.html:11
#: ckanext/validate/templates/validate/test_file.html:49
msgid "Validate"
msgstr "Validar"

#: ckanext/validate/templates/package/resource_validate.html:7
msgid "Resource Validation"
msgstr "Validación del recurso"

#: ckanext/validate/templates/package/resource_validate.html:24
#: ckanext/validate/templates/validate/test_file.html:14
msgid "Current Status"
msgstr "Estado actual"

#: ckanext/validate/templates/package/resource_validate.html:30
msgid "Last validation:"
msgstr "Última validación:"

#: ckanext/validate/templates/package/resource_validate.html:36
msgid "Validation is waiting in the queue."
msgstr "La validación está esperando en la cola."

#: ckanext/validate/templates/package/resource_validate.html:38
msgid "Validation is running in the background."
msgstr "La validación se está ejecutando en segundo plano."

#: ckanext/validate/templates/package/resource_validate.html:40
msgid "No errors found for this resource."
msgstr "No se encontraron errores para este recurso."

#: ckanext/validate/templates/package/resource_validate.html:43
msgid "errors detected"
msgstr "errores detectados"

#: ckanext/validate/templates/package/resource_validate.html:46
msgid "An error occurred while running the validator."
msgstr "Ocurrió un error al ejecutar el validador."

#: ckanext/validate/templates/package/resource_validate.html:62
msgid "Run Validation"
msgstr "Ejecutar validación"

#: ckanext/validate/templates/package/resource_validate.html:72
#: ckanext/validate/templates/validate/test_file.html:59
msgid "About CSV Validation"
msgstr "Acerca de la validación CSV"

#: ckanext/validate/templates/package/resource_validate.html:75
#: ckanext/validate/templates/validate/test_file.html:62
msgid ""
"This tool checks your CSV file for structural errors, missing values, and"
" inconsistent data types or formats."
msgstr ""
"Esta herramienta verifica su archivo CSV en busca de errores estructurales, "
"valores faltantes y tipos o formatos de datos inconsistentes."

#: ckanext/validate/templates/package/resource_validate.html:83
#: ckanext/validate/templates/validate/test_file.html:70
msgid "Checks headers and the number of columns in each row."
msgstr "Verifica los encabezados y el número de columnas en cada fila."

#: ckanext/validate/templates/package/resource_validate.html:86
#: ckanext/validate/templates/validate/test_file.html:73
msgid "Validates required values and inferred data types."
msgstr "Valida los valores requeridos y los tipos de datos inferidos."

#: ckanext/validate/templates/package/resource_validate.html:89
#: ckanext/validate/templates/validate/test_file.html:76
msgid "Detects invalid numeric values and date formats."
msgstr "Detecta valores numéricos inválidos y formatos de fecha incorrectos."

#: ckanext/validate/templates/package/resource_validate.html:95
#: ckanext/validate/templates/validate/test_file.html:82
msgid "View validation rules applied"
msgstr "Ver reglas de validación aplicadas"

#: ckanext/validate/templates/package/resource_validate.html:99
#: ckanext/validate/templates/validate/test_file.html:86
msgid "Headers"
msgstr "Encabezados"

#: ckanext/validate/templates/package/resource_validate.html:101
#: ckanext/validate/templates/validate/test_file.html:88
msgid "Column headers must not be empty."
msgstr "Los encabezados de columna no deben estar vacíos."

#: ckanext/validate/templates/package/resource_validate.html:102
#: ckanext/validate/templates/validate/test_file.html:89
msgid "Column names must be unique."
msgstr "Los nombres de las columnas deben ser únicos."

#: ckanext/validate/templates/package/resource_validate.html:105
#: ckanext/validate/templates/validate/test_file.html:92
msgid "Rows and columns"
msgstr "Filas y columnas"

#: ckanext/validate/templates/package/resource_validate.html:107
#: ckanext/validate/templates/validate/test_file.html:94
msgid "Completely empty rows are reported as errors."
msgstr "Las filas completamente vacías se informan como errores."

#: ckanext/validate/templates/package/resource_validate.html:109
#: ckanext/validate/templates/validate/test_file.html:96
msgid "Each row must contain the same number of cells as the header row."
msgstr "Cada fila debe contener el mismo número de celdas que la fila de encabezado."

#: ckanext/validate/templates/package/resource_validate.html:115
#: ckanext/validate/templates/validate/test_file.html:102
msgid "Rows with missing or extra cells are reported as errors."
msgstr "Las filas con celdas faltantes o adicionales se informan como errores."

#: ckanext/validate/templates/package/resource_validate.html:121
#: ckanext/validate/templates/validate/test_file.html:108
msgid "Required values"
msgstr "Valores requeridos"

#: ckanext/validate/templates/package/resource_validate.html:123
#: ckanext/validate/templates/validate/test_file.html:110
msgid "All detected columns are considered required."
msgstr "Todas las columnas detectadas se consideran obligatorias."

#: ckanext/validate/templates/package/resource_validate.html:125
#: ckanext/validate/templates/validate/test_file.html:112
msgid ""
"Empty cells and the values null, NULL, and None are reported as missing "
"values."
msgstr ""
"Las celdas vacías y los valores null, NULL y None se informan como "
"valores faltantes."

#: ckanext/validate/templates/package/resource_validate.html:132
#: ckanext/validate/templates/validate/test_file.html:119
msgid "Data types"
msgstr "Tipos de datos"

#: ckanext/validate/templates/package/resource_validate.html:135
#: ckanext/validate/templates/validate/test_file.html:122
msgid ""
"The predominant values in each column are analyzed to determine the "
"expected data type."
msgstr ""
"Los valores predominantes de cada columna se analizan para determinar el "
"tipo de dato esperado."

#: ckanext/validate/templates/package/resource_validate.html:141
#: ckanext/validate/templates/validate/test_file.html:128
msgid ""
"Values that do not match the expected type or format are reported as "
"errors."
msgstr ""
"Los valores que no coinciden con el tipo o formato esperado se informan "
"como errores."

#: ckanext/validate/templates/package/resource_validate.html:148
#: ckanext/validate/templates/validate/snippets/validation_rules.html:17
#: ckanext/validate/templates/validate/test_file.html:135
msgid "Numeric values"
msgstr "Valores numéricos"

#: ckanext/validate/templates/package/resource_validate.html:151
#: ckanext/validate/templates/validate/test_file.html:138
#, python-format
msgid ""
"When at least 50%% of the values are numeric, the column is validated as "
"numeric."
msgstr ""
"Cuando al menos el 50%% de los valores son numéricos, la columna se "
"valida como numérica."

#: ckanext/validate/templates/package/resource_validate.html:157
#: ckanext/validate/templates/validate/test_file.html:144
msgid ""
"The column is validated as an integer when all detected numbers are whole"
" numbers, or as a decimal number otherwise."
msgstr ""
"La columna se valida como número entero cuando todos los números detectados "
"son enteros, o como número decimal en caso contrario."

#: ckanext/validate/templates/package/resource_validate.html:164
#: ckanext/validate/templates/validate/snippets/validation_rules.html:29
#: ckanext/validate/templates/validate/test_file.html:151
msgid "Date values"
msgstr "Valores de fecha"

#: ckanext/validate/templates/package/resource_validate.html:167
#: ckanext/validate/templates/validate/test_file.html:154
#, python-format
msgid ""
"When at least 50%% of the values match a date format, the complete column"
" is validated using that format."
msgstr ""
"Cuando al menos el 50%% de los valores coinciden con un formato de fecha, "
"la columna completa se valida usando ese formato."

#: ckanext/validate/templates/package/resource_validate.html:173
#: ckanext/validate/templates/validate/test_file.html:160
msgid "Supported formats:"
msgstr "Formatos admitidos:"

#: ckanext/validate/templates/package/snippets/test_file_link.html:7
msgid "Validate CSV file"
msgstr "Validar archivo CSV"

#: ckanext/validate/templates/package/snippets/test_file_link.html:11
msgid "Validate CSV"
msgstr "Validar CSV"

#: ckanext/validate/templates/validate/test_file.html:3
msgid "Validate File"
msgstr "Validar archivo"

#: ckanext/validate/templates/validate/test_file.html:6
msgid "Validate a CSV File"
msgstr "Validar un archivo CSV"

#: ckanext/validate/templates/validate/test_file.html:8
msgid ""
"Upload a CSV file to check it for errors. The file will not be saved or "
"linked to any dataset."
msgstr ""
"Suba un archivo CSV para verificar errores. El archivo no se guardará ni "
"se vinculará a ningún conjunto de datos."

#: ckanext/validate/templates/validate/snippets/validation_badge.html:18
#: ckanext/validate/templates/validate/test_file.html:16
